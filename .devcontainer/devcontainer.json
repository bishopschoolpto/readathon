{
  "name": "PTO App Environment",
  // Node 24 (LTS) on Debian trixie. Pinned to a major line so rebuilds are reproducible;
  // patch releases still update when the image is re-pulled.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-trixie",
  // Installs Claude Code, clasp + Playwright, and headless Chromium with its system libraries for UI tests.
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && npm install && sudo npx playwright install-deps chromium && npx playwright install chromium",
  "remoteUser": "node",
  // Publishes the dev server (npm run dev) to the host's localhost:8082. The
  // devcontainer CLI ignores "forwardPorts"; it applies "appPort" when the container is created.
  "appPort": ["8082:8082"],

  "runArgs": ["--userns=keep-id", "--tmpfs", "/tmp:exec,mode=1777"]
}